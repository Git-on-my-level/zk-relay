{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zk-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SECRET_OBJECT",
        "class_name": "SecretObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecretObject"]
    }
  ],
  "routes": [
    { "pattern": "zkr.scalingforever.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "ZK Relay",
    "ACCENT_COLOR": "#247a3b",
    "TOOL_VERSION": "v1.3.0",
    "TOOL_RELEASE_BASE_URL": "https://zkr.scalingforever.com/tools/v1.3.0",
    "TOOL_GPG_FINGERPRINT": "88E4D43113025649CDB6773953607CDFBABCDC86",
    "TOOL_SHA256_LINUX_AMD64": "644ef0c2c58808dc0bcd6c53241d206b6494b40ee9dd71834298eb7c1f2dfe3e",
    "TOOL_SHA256_LINUX_ARM64": "081a91f074d0f3c96f27f997083c15a4fb36a39c4c649a370d0b6dedfa84e60e",
    "TOOL_SHA256_DARWIN_AMD64": "2796ef49db92b4e4f4243a514c0e9db266423855914f5ca5d63ee46c7aee0a2a",
    "TOOL_SHA256_DARWIN_ARM64": "5f72ce14792e11ee70895ee0b7f3b49907c26cc42fa28a585070552a59b10263",
    "TOOL_SHA256_WINDOWS_AMD64": "ae16b8cf6616e6d3c2381fb3bd2ae63f6c839678cb5ef88da763a3cdf653eef5"
  }
}
