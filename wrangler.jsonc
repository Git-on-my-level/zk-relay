{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zk-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SECRET_OBJECT",
        "class_name": "SecretObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecretObject"]
    }
  ],
  "routes": [
    { "pattern": "zkr.scalingforever.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "ZK Relay",
    "ACCENT_COLOR": "#247a3b",
    "TOOL_VERSION": "v1.3.1",
    "TOOL_RELEASE_BASE_URL": "https://zkr.scalingforever.com/tools/v1.3.1",
    "TOOL_GPG_FINGERPRINT": "88E4D43113025649CDB6773953607CDFBABCDC86",
    "TOOL_SHA256_LINUX_AMD64": "d06da2b50992b3ddf12d0887132640610b7eeff3550db2e360587e9909ca5588",
    "TOOL_SHA256_LINUX_ARM64": "8a69cd5cbde61ad3995cb5664baf91989aaf7182e1b0c5ae1d8def57763b4d46",
    "TOOL_SHA256_DARWIN_AMD64": "6b5adc59927c0a99cc6ad0e7a20c54b178679aeec9a3b3f6ffbb6bde3280e413",
    "TOOL_SHA256_DARWIN_ARM64": "19a419ff565a6547209864df7d0e224e8845badc71faa8a035c3f5dba967419d",
    "TOOL_SHA256_WINDOWS_AMD64": "1e5a430ae16d6d14f1fd45ed83a8dc0dbd154ff7e791416df6aa6caf9ea3a692"
  }
}
