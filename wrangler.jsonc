{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zk-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SECRET_OBJECT",
        "class_name": "SecretObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecretObject"]
    }
  ],
  "routes": [
    { "pattern": "zkr.scalingforever.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "ZK Relay",
    "ACCENT_COLOR": "#247a3b",
    "TOOL_VERSION": "v1.3.2",
    "TOOL_RELEASE_BASE_URL": "https://zkr.scalingforever.com/tools/v1.3.2",
    "TOOL_GPG_FINGERPRINT": "88E4D43113025649CDB6773953607CDFBABCDC86",
    "TOOL_SHA256_LINUX_AMD64": "d227c02ac60acd2dd36aec31dc6ee34bc593d6012fc1dd359a9143b1868e5d30",
    "TOOL_SHA256_LINUX_ARM64": "7fafb3bae8fbfb116b7d13713f1e679c5367fb03dc3b638697b7f9e4dc6573e7",
    "TOOL_SHA256_DARWIN_AMD64": "2c71862db9a36722cd63519f1de80d0f628800f3f2a270c6cd594abe643eaa28",
    "TOOL_SHA256_DARWIN_ARM64": "6eff8a4dc98bf590ca1450a40b7f4ddd6ff282e94ad92639e9a966f77fbc4360",
    "TOOL_SHA256_WINDOWS_AMD64": "ca3d7337f47e777dd196bf2b70020016b85fe8242599cfc52b4239477cf807f9"
  }
}
