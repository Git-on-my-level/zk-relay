{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zk-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SECRET_OBJECT",
        "class_name": "SecretObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecretObject"]
    }
  ],
  "routes": [
    { "pattern": "zkr.scalingforever.com", "custom_domain": true }
  ],
  "vars": {
    "APP_NAME": "ZK Relay",
    "ACCENT_COLOR": "#247a3b",
    "TOOL_VERSION": "v1.2.2",
    "TOOL_RELEASE_BASE_URL": "https://zkr.scalingforever.com/tools/v1.2.2",
    "TOOL_GPG_FINGERPRINT": "88E4D43113025649CDB6773953607CDFBABCDC86",
    "TOOL_SHA256_LINUX_AMD64": "8ede96c0a1174da0c70ff99a862e6b42dd32b3f3bdd1cef6a46d3c2174082b58",
    "TOOL_SHA256_LINUX_ARM64": "b753f579ee30f93906cf653610772bff06c7b1eccb932a41aba104625a9edf86",
    "TOOL_SHA256_DARWIN_AMD64": "bcae1a570a16ad96a922bfdeefd576323f8c56b7efd8548568f8de5c5864f407",
    "TOOL_SHA256_DARWIN_ARM64": "c9e28eec1cc3f1f1fc8f1ffaab5c501f748bc3133115df32797ae70483921c18",
    "TOOL_SHA256_WINDOWS_AMD64": "ddc489522b71c163b7438957753ade49aacc186f7e096eb07831bdf0cc67a44a"
  }
}
